@{
    Layout = "~/views/layout.cshtml";
}
<!-- main content -->
<!-- preloader -->
<div class="preloader">
    <div>
        <div class="multi-spinner-container">
            <div class="multi-spinner">
                <div class="multi-spinner">
                    <div class="multi-spinner">
                        <div class="multi-spinner">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- preloader end -->
@Html.Partial("~/views/partials/header.cshtml")

<!-- References Page -->
